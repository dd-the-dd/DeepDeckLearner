# local or ddl
DEEPDECK_TARGET=local
DEEPDECK_EXAMPLE=alexios
DEEPDECK_SPEED=1s

MTG_ENGINE_URL=http://127.0.0.1:8787
MTG_ENGINE_API_KEY=
DEEPDECK_LOCAL_DECK_SESSION_ID=
DEEPDECK_LOCAL_OPPONENT_DECK_SESSION_ID=
DEEPDECK_LOCAL_OPPONENT_CONTROLLER=ai-random
DEEPDECK_LOCAL_FORMAT=
DEEPDECK_LOCAL_MAX_TURNS=200

# Required only for the public target. Generate it from the DDL account page.
DEEPDECK_PLATFORM_URL=https://staging.deepdeckleague.com/api/v1
DEEPDECK_API_KEY=
DEEPDECK_AGENT_ID=com.deepdeckleague.example.alexios
DEEPDECK_AGENT_VERSION=0.1.0
DEEPDECK_COMPETITION_VERSION_ID=
DEEPDECK_AGENT_VERSION_ID=
DEEPDECK_DECK_VERSION_ID=

# Immutable DDL deck-version ID, or the local session name `alexios` for local play.
ALEXIOS_DECK_ID=alexios

# V11/V12 only. Checkpoints and model weights are ignored by Git.
DEEPDECK_CHECKPOINT=
DEEPDECK_DEVICE=cpu
